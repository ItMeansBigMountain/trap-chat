{
  "buildCommand": "cd expo && npm ci && npx expo export --platform web",
  "outputDirectory": "expo/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/socket.io/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": { "runtime": "python@3.12" }
  }
}