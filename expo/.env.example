# Public values are embedded into the client bundle. Never put secrets here.
# Local development defaults to the same origin in the browser.
EXPO_PUBLIC_API_URL=https://YOUR_BACKEND_HOST
EXPO_PUBLIC_SOCKET_URL=https://YOUR_BACKEND_HOST

# Optional public runtime metadata
EXPO_PUBLIC_APP_ENV=development

# Backend-only values belong in Vercel/Render/Railway/Azure secrets,
# never in EXPO_PUBLIC_* variables:
# SECRET_KEY=
# DATABASE_URL=
# FRONTEND_ORIGIN=
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
